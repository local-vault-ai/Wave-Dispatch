# Wave Dispatch environment. The setup helper copies this to .env (git-ignored). Never commit .env.

# The one local endpoint (default: standard Ollama). Examples:
#   http://127.0.0.1:11434      Ollama (default)
#   http://127.0.0.1:8003       Ollama started with OLLAMA_HOST=127.0.0.1:8003
WAVE_DISPATCH_ENDPOINT=http://127.0.0.1:11434

# Optional: a second computer (see dispatch_vault/Machines/Second Computer.md).
# Use your own LAN address; prefer a TLS proxy with a key over an open port.
WAVE_DISPATCH_NODE2_URL=
WAVE_DISPATCH_NODE2_API_KEY=
